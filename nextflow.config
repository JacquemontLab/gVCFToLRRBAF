params {
    // Input / output directories
    inputDirpVCF = null      // e.g. "/path/to/pvcf"
    inputDirgVCF = null      // e.g. "/path/to/gvcf"
    outputDir    = "results"

    // Pipeline scripts
    scriptDir = "${projectDir}/scripts"

    // Cohort-level reference panel
    PLINK_filter_options = "--geno 0.05 --mind 0.05 --hwe 1e-6 --maf 0.001"

    // PFB estimation
    topN            = 1000
    n_batches       = 20
    polars_threads  = 4
    baf_dir_path    = null

    // Batch sizes
    gvcf_batch_size   = 125
    filter_batch_size = 250

    // Optional SLURM account
    slurm_account = null     // e.g. "rrg-jacquese"
}

executor {
    name            = 'slurm'
    queueSize       = 100
    submitRateLimit = '10/1min'
}

process {

    // SLURM account can be supplied at runtime:
    // --slurm_account YOUR_ACCOUNT
    clusterOptions = params.slurm_account
        ? "--account=${params.slurm_account}"
        : ''

    errorStrategy = {
        task.exitStatus in [137, 140] ? 'retry' : 'finish'
    }

    maxRetries = 2

    // Default resources
    cpus   = 4
    memory = '16 GB'
    time   = '2h'

    withName: 'pVCF_to_plink' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: 'plink_filter_merge' {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: 'gvcf_to_signalintensity' {
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: 'pfb_partial' {
        cpus   = 4
        memory = { 64.GB * task.attempt }
        time   = { 5.h * task.attempt }
    }

    withName: 'pfb_reduce' {
        cpus   = 4
        memory = { 64.GB * task.attempt }
        time   = '3h'
    }

    withName: 'filter_baf_lrr_files' {
        cpus   = 2
        memory = { 64.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: 'select_unrel_topN' {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = '1h'
    }

    withName: 'split_iids' {
        cpus   = 2
        memory = { 32.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
}
